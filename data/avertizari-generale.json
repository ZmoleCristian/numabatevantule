{
  "avertizare": {
    "@attributes": {
      "catre": "Preşedinţia României, Secretariatul General al Guvernului României, Departamentul pentru Situații de Urgență, Inspectoratul General pentru Situaţii de Urgenţă, Ministerul Mediului, Apelor şi Pădurilor, Ministerul Afacerilor Interne, Ministerul Transporturilor şi Infrastructurii, Ministerul Apărării Naţionale, Ministerul Agriculturii şi Dezvoltării Rurale, C.N.A.I.R, Administraţia Naţională “Apele Române”, S.N.C.F.R , mass-media",
      "culoare": "0",
      "dataAparitiei": "2026-10-18T10:00",
      "dataExpirarii": "2026-10-20T20:00",
      "fenomeneVizate": "conform textelor",
      "intervalul": "conform textelor",
      "mesaj": "<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><strong><span lang=\"RO\">INFORMARE METEOROLOGICĂ<br /> Interval de valabilitate: 18 octombrie, ora 10 &ndash; 20 octombrie, ora 02<br /> Fenomene vizate: intensificări ale v&acirc;ntului, ploi moderate cantitativ, predominant ninsori la altitudini de peste 2000 m <br /> Zone afectate: conform textului</span></strong></span></p>\r\n<p><span style=\"font-size: small; color: #000000;\"><span style=\"font-family: verdana, geneva;\" lang=\"RO\">&nbsp; &nbsp; &nbsp;Temporar vor fi intensificări ale v&acirc;ntului &icirc;n Moldova și Dobrogea, cu viteze &icirc;n general de 45...60 km/h, local și &icirc;n sudul Banatului și vestul Olteniei (viteze de 40...45 km/h), iar la munte, &icirc;n special &icirc;n zona &icirc;naltă a Munților Banatului și a Carpaților Meridionali și de Curbură vor fi rafale de 70...90 km/h.<br /></span><span style=\"font-family: verdana, geneva;\">&nbsp; &nbsp; &nbsp;Va ploua &icirc;n Moldova, Dobrogea, jumătatea de est a Munteniei și Transilvaniei și se vor acumula cantități de apă de 10...20 l/mp și izolat de peste 30...35 l/mp.<br /></span><span style=\"font-family: verdana, geneva;\">&nbsp; &nbsp; &nbsp;La altitudini mari, &icirc;n general de peste 2000 m, vor fi precipitații predominant sub formă de ninsoare și cu precădere &icirc;n estul Carpaților Meridionali (masivele Bucegi și Făgăraș), pe tot intervalul se va depune strat de zăpadă &icirc;n general de 10...20 cm.</span></span></p>\r\n<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><strong><span lang=\"RO\">ATENȚIONARE METEOROLOGICĂ</span></strong></span></p>\r\n<p align=\"center\"><span style=\"font-size: small; color: #000000;\"><span style=\"font-family: verdana, geneva;\" lang=\"RO\"><img style=\"font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 10px;\" src=\"../wp-content/plugins/meteo/admin/images/galben.gif\" alt=\"\" align=\"absmiddle\" /><strong>COD GALBEN<br /> Interval de valabilitate: 18 octombrie, ora 21 &ndash; 19 octombrie, ora 21<br /> Fenomene vizate: intensificări ale v&acirc;ntului<br /></strong></span><strong style=\"font-family: verdana, geneva; font-size: small;\"><span lang=\"RO\">Zone afectate: Moldova și local Dobrogea</span></strong><strong style=\"font-family: verdana, geneva; font-size: small;\"><span lang=\"RO\">&nbsp;</span></strong></span></p>\r\n<p><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><span lang=\"RO\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &Icirc;n intervalul menționat, &icirc;n Moldova și local &icirc;n Dobrogea</span><span lang=\"RO\"> v&acirc;ntul va avea intensificări cu viteze de 50...70 km/h.</span></span></p>\r\n<p>&nbsp;</p>\r\n<p>&nbsp;</p>\r\n<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><strong><em><span lang=\"RO\">&Icirc;n funcţie de evoluţia şi intensitatea fenomenelor meteorologice, Administraţia Naţională de Meteorologie va actualiza prezentul mesaj</span></em></strong><strong><em><span lang=\"RO\">.</span></em></strong></span></p>\r\n<p>&nbsp;</p>",
      "numeCuloare": "galben",
      "numeTipMesaj": "Atenționare meteorologică",
      "tipMesaj": "1",
