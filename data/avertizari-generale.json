{
  "avertizare": {
    "@attributes": {
      "catre": "Preşedinţia României, Secretariatul General al Guvernului României, Departamentul pentru Situații de Urgență, Inspectoratul General pentru Situaţii de Urgenţă, Ministerul Mediului, Apelor şi Pădurilor, Ministerul Afacerilor Interne, Ministerul Transporturilor şi Infrastructurii, Ministerul Apărării Naţionale, Ministerul Agriculturii şi Dezvoltării Rurale, C.N.A.I.R, Administraţia Naţională “Apele Române”, S.N.C.F.R , mass-media",
      "culoare": "0",
      "dataAparitiei": "2026-11-11T10:00",
      "dataExpirarii": "2026-11-13T22:00",
      "fenomeneVizate": "conform textelor",
      "intervalul": "conform textelor",
      "mesaj": "<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><strong><span lang=\"RO\">INFORMARE METEOROLOGICĂ<br /> Interval de valabilitate: 11 noiembrie, ora 22 &ndash; 13 noiembrie, ora 22<br /> Fenomene vizate: ploi moderate cantitativ și intensificări ale v&acirc;ntului<br /> Zone afectate: conform textului</span></strong></span></p>\r\n<p><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\" lang=\"RO\">&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&Icirc;n intervalul menționat vor fi ploi moderate cantitativ &icirc;n vestul, nord-vestul și local &icirc;n centrul țării. Cantitățile de apă vor fi &icirc;n general de 30...60 l/mp.<br /></span><span style=\"font-family: verdana, geneva; font-size: small;\">&nbsp; &nbsp; V&acirc;ntul va avea intensificări temporare &icirc;n noaptea de joi spre vineri (12/13 noiembrie) la munte și &icirc;n regiunile vestice, iar vineri (13 noiembrie) &icirc;n vestul, nordul, centrul și estul teritoriului. Vor fi viteze &icirc;n general de 40...60 km/h, iar la altitudini mari rafalele vor depăși 70...90 km/h.</span></p>\r\n<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><strong><span lang=\"RO\">&nbsp;</span></strong></span></p>\r\n<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><strong><span lang=\"RO\">ATENȚIONARE METEOROLOGICĂ </span></strong></span></p>\r\n<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\" lang=\"RO\"><img style=\"font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 10px;\" src=\"../wp-content/plugins/meteo//admin/images/galben.gif\" alt=\"\" align=\"absmiddle\" /><strong>COD GALBEN<br /> Interval de valabilitate: 11 noiembrie, ora 22 &ndash; 12 noiembrie, ora 22<br /> Fenomene și zone vizate: ploi &icirc;nsemnate cantitativ &icirc;n Banat, sudul Crișanei, Carpații Occidentali și &icirc;n vestul Carpaților Meridionali<br /> <br /> </strong></span></p>\r\n<p><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><span lang=\"RO\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &Icirc;n intervalul menționat, </span><span lang=\"RO\">&icirc;n Banat, sudul Crișanei, Carpații Occidentali și &icirc;n vestul Carpaților Meridionali va ploua și se vor acumula cantități de apă de 25...50 l/mp și izolat peste 60 l/mp &icirc;n zona montană.</span></span></p>\r\n<p>&nbsp;</p>\r\n<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><strong><em><span lang=\"RO\">&Icirc;n funcţie de evoluţia şi intensitatea fenomenelor meteorologice, Administraţia Naţională de Meteorologie va actualiza prezentul mesaj</span></em></strong><strong><em><span lang=\"RO\">.</span></em></strong></span></p>",
      "numeCuloare": "galben",
      "numeTipMesaj": "Atenționare meteorologică",
      "tipMesaj": "1",
      "zonaAfectata": "conform textelor și hărții"
