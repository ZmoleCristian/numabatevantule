      "mesaj": "<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><strong><span lang=\"RO\">&nbsp;</span></strong></span></p>\r\n<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><strong><span lang=\"RO\">ATENȚIONARE METEOROLOGICĂ</span></strong></span></p>\r\n<p align=\"center\"><span style=\"color: #000000;\"><img src=\"../wp-content/plugins/meteo/admin/images/galben.gif\" alt=\"\" align=\"absmiddle\" /><span style=\"font-size: small; font-family: verdana, geneva;\"><strong><span lang=\"RO\">COD GALBEN</span></strong></span></span></p>\r\n<p align=\"center\"><span style=\"color: #000000;\"><span style=\"font-size: small; font-family: verdana, geneva;\"><strong><span lang=\"RO\">Interval de valabilitate: 28 august, ora 08 &ndash; 28 august, ora 20<br /></span></strong></span><strong style=\"font-family: verdana, geneva; font-size: small;\"><span lang=\"RO\">Fenomene vizate: intensificări ale v&acirc;ntului<br /></span></strong><strong style=\"font-family: verdana, geneva; font-size: small;\"><span lang=\"RO\">Zone afectate: Dobrogea, estul Munteniei și sud-estul Moldovei<br /><br /></span></strong></span></p>\r\n<p><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><span lang=\"RO\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span><span lang=\"RO\"> Pe parcursul zilei de vineri (28 august), &icirc;n Dobrogea, estul Munteniei și sud-estul Moldovei vor fi intensificări ale v&acirc;ntului cu viteze de 50...70 km/h.</span></span></p>\r\n<p>&nbsp;</p>\r\n<p><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\" lang=\"RO\"><strong><em><span lang=\"RO\">&Icirc;n funcţie de evoluţia şi intensitatea fenomenelor meteorologice, Administraţia Naţională de Meteorologie va actualiza prezentul mesaj</span></em></strong><strong><em><span lang=\"RO\">.</span></em></strong> </span></p>",
