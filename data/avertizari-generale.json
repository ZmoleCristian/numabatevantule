{
  "avertizare": {
    "@attributes": {
      "catre": "Preşedinţia României, Secretariatul General al Guvernului României, Departamentul pentru Situații de Urgență, Inspectoratul General pentru Situaţii de Urgenţă, Ministerul Mediului, Apelor şi Pădurilor, Ministerul Afacerilor Interne, Ministerul Transporturilor şi Infrastructurii, Ministerul Apărării Naţionale, Ministerul Agriculturii şi Dezvoltării Rurale, C.N.A.I.R, Administraţia Naţională “Apele Române”, S.N.C.F.R , mass-media",
      "culoare": "0",
      "dataAparitiei": "2026-09-28T10:00",
      "dataExpirarii": "2026-09-30T20:00",
      "fenomeneVizate": "intensificări ale vântului",
      "intervalul": "conform textelor",
      "mesaj": "<p align=\"center\"><span style=\"font-family: verdana, geneva; font-size: small; color: #000000;\"><strong><span lang=\"RO\">INFORMARE METEOROLOGICĂ<br /> Interval de valabilitate: 28 septembrie, ora 10 &ndash; 30 septembrie, ora 20<br /> Fenomene vizate: intensificări ale v&acirc;ntului<br /> Zone afectate: conform textului</span></strong></span></p>\r\n<p><span style=\"font-family: verdana, geneva; font-size: small; color: #000000;\" lang=\"RO\">&Icirc;n intervalul menționat, temporar, v&acirc;ntul va avea intensificări &icirc;n jumătatea de sud a Moldovei, Dobrogea și cea mai mare parte a Munteniei cu viteze &icirc;n general de 45...55 km/h, precum și &icirc;n zona Carpaților de Curbură cu rafale de 55...75 km/h.</span></p>\r\n<p><span style=\"font-family: verdana, geneva; font-size: small; color: #000000;\" lang=\"RO\">&nbsp;</span></p>\r\n<p align=\"center\"><span style=\"font-family: verdana, geneva; font-size: small; color: #000000;\"><strong><span lang=\"RO\">ATENȚIONARE METEOROLOGICĂ</span></strong></span></p>\r\n<p align=\"center\"><span style=\"font-size: small; color: #000000;\"><img src=\"../wp-content/plugins/meteo/admin/images/galben.gif\" alt=\"\" align=\"absmiddle\" /><span style=\"font-family: verdana, geneva;\"><strong><span lang=\"RO\">COD GALBEN</span></strong></span></span></p>\r\n<p align=\"center\"><span style=\"font-family: verdana, geneva; font-size: small; color: #000000;\"><strong><span lang=\"RO\">Interval de valabilitate: 28</span></strong><strong><span lang=\"RO\"> septembrie, ora 10 &ndash; 28 septembrie, ora 20<br /> Fenomene vizate: intensificări ale v&acirc;ntului<br /> Zone afectate: județele Bacău, Vaslui, Vrancea, Galați, Buzău, Brăila, Ialomița, Călărași, Tulcea și Constanța</span></strong></span></p>\r\n<p><span style=\"font-family: verdana, geneva; font-size: small; color: #000000;\"><strong><span lang=\"RO\">&nbsp;</span></strong></span></p>\r\n<p><span style=\"font-size: small; color: #000000;\"><span style=\"font-family: verdana, geneva;\"><span lang=\"RO\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span><span style=\"font-family: verdana, geneva;\"><span lang=\"RO\">&nbsp;Pe parcursul zilei de luni (28 septembrie) </span></span><span style=\"font-family: verdana, geneva;\"><span lang=\"RO\">&icirc;n județele Bacău, Vaslui, Vrancea, Galați, Buzău, Brăila, Ialomița, Călărași, Tulcea și Constanța v&acirc;ntul va avea intensificări cu viteze de 50...70 km/h.</span></span></span></p>\r\n<p><span style=\"font-size: small; color: #000000;\">&nbsp;</span></p>\r\n<p><span style=\"font-size: small; color: #000000;\">&nbsp;</span></p>\r\n<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><strong><em><span lang=\"RO\">&Icirc;n funcţie de evoluţia şi intensitatea fenomenelor meteorologice, Administraţia Naţională de Meteorologie va actualiza prezentul mesaj</span></em></strong><strong><em><span lang=\"RO\">.</span></em></strong></span></p>\r\n<p><span style=\"font-size: small; color: #000000;\">&nbsp;</span></p>",
      "numeCuloare": "galben",
      "numeTipMesaj": "Atenționare meteorologică",
      "tipMesaj": "1",
