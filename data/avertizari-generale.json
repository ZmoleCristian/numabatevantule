      "intervalul": "10 septembrie, ora 12 – 10 septembrie, ora 18;",
      "mesaj": "<p align=\"center\"><span style=\"font-family: verdana, geneva; font-size: large; color: #000000;\"><strong><span lang=\"RO\">MESAJ 2</span></strong></span></p>\r\n<p align=\"center\"><span style=\"font-family: verdana, geneva; font-size: medium; color: #000000;\"><strong><span lang=\"RO\">ATENȚIONARE METEOROLOGICĂ<br /></span></strong></span><img src=\"../wp-content/plugins/meteo/admin/images/galben.gif\" alt=\"\" align=\"absmiddle\" /><span style=\"font-family: verdana, geneva; font-size: medium; color: #000000;\"><strong><span lang=\"RO\">COD GALBEN</span></strong></span></p>\r\n<p align=\"center\"><span style=\"font-family: verdana, geneva; font-size: small; color: #000000;\"><strong><span lang=\"RO\">Interval de valabilitate: 10 septembrie, ora 12 &ndash; 10 septembrie, ora 18<br /></span></strong><strong><span lang=\"RO\">Fenomene vizate: temperaturi deosebit de ridicate<br /></span></strong><strong><span lang=\"RO\">Zone afectate: sudul Banatului, sud-vestul Olteniei și al Transilvaniei</span></strong></span></p>\r\n<p style=\"text-align: justify;\" align=\"center\"><span style=\"font-family: verdana, geneva; font-size: small; color: #000000;\">&nbsp; &nbsp; &nbsp; Joi (10 septembrie) &icirc;n sudul Banatului, &icirc;n sud-vestul Olteniei și al Transilvaniei vor fi temperaturi deosebit de ridicate. Temperaturile maxime vor fi cuprinse &icirc;ntre 30 și 34 de grade.</span></p>\r\n<p style=\"text-align: center;\" align=\"center\"><span style=\"font-family: verdana, geneva; font-size: small; color: #000000;\"><strong><em><span lang=\"RO\">&Icirc;n funcţie de evoluţia şi intensitatea fenomenelor meteorologice, Administraţia Naţională de Meteorologie va actualiza prezentul mesaj</span></em></strong><strong><em><span lang=\"RO\">.</span></em></strong></span></p>",
