  "avertizare": {
    "@attributes": {
      "catre": "Preşedinţia României, Secretariatul General al Guvernului României, Departamentul pentru Situații de Urgență, Inspectoratul General pentru Situaţii de Urgenţă, Ministerul Mediului, Apelor şi Pădurilor, Ministerul Afacerilor Interne, Ministerul Transporturilor şi Infrastructurii, Ministerul Apărării Naţionale, Ministerul Agriculturii şi Dezvoltării Rurale, C.N.A.I.R, Administraţia Naţională “Apele Române”, S.N.C.F.R , mass-media",
      "culoare": "0",
      "dataAparitiei": "2026-07-27T10:00",
      "dataExpirarii": "2026-07-28T20:00",
      "fenomeneVizate": "intensificări ale vântului",
      "intervalul": "28 iulie, ora 10 – 28 iulie, ora 20",
      "mesaj": "<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><strong><span lang=\"IT\">ATENȚIONARE METEOROLOGICĂ</span></strong></span></p>\r\n<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><img src=\"../wp-content/plugins/meteo/admin/images/galben.gif\" alt=\"\" align=\"absmiddle\" /><strong><span lang=\"RO\">COD GALBEN</span></strong></span></p>\r\n<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><strong><span lang=\"RO\">Interval de valabilitate: 28 iulie, ora 10 &ndash; 28 iulie, ora 20<br /></span></strong><strong><span lang=\"RO\">Fenomene vizate: intensificări ale v&acirc;ntului<br /></span></strong><strong><span lang=\"RO\">Zone afectate: estul Moldovei și zona Carpaților de Curbură</span></strong></span></p>\r\n<p align=\"center\"><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\"><strong><span lang=\"RO\">&nbsp;</span></strong></span></p>\r\n<p><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\" lang=\"RO\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Pe parcursul zilei de marți (28 iulie) temporar v&acirc;ntul va avea intensificări &icirc;n estul Moldovei, cu viteze la rafală de 50...70 km/h, precum și &icirc;n zona Carpaților de Curbură cu rafale de 70...90 km/h.</span></p>\r\n<p><span style=\"font-size: small; font-family: verdana, geneva; color: #000000;\" lang=\"RO\">Notă: intensificări ale v&acirc;ntului cu viteze la rafală &icirc;n general de 45...50 km/h vor fi &icirc;n centrul Moldovei, estul Transilvaniei, nordul Dobrogei și &icirc;n vestul Olteniei.</span></p>\r\n<p>&nbsp;</p>\r\n<p>&nbsp;</p>\r\n<p align=\"center\"><span style=\"font-size: small; color: #000000;\"><strong><em><span lang=\"RO\">&Icirc;n funcţie de evoluţia şi intensitatea fenomenelor meteorologice, Administraţia Naţională de Meteorologie va actualiza prezentul mesaj</span></em></strong><strong><em><span lang=\"RO\">.</span></em></strong></span></p>\r\n<p>&nbsp;</p>",
      "numeCuloare": "galben",
      "numeTipMesaj": "Atenționare meteorologică",
      "tipMesaj": "1",
      "zonaAfectata": "estul Moldovei și zona Carpaților de Curbură"
